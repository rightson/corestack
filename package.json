{
  "name": "corestack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api & npm run dev:vite",
    "dev:vite": "vite",
    "dev:api": "tsx watch server-fastify/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server-fastify/index.js",
    "preview": "vite preview",
    "lint": "eslint src server server-fastify",
    "lint:fix": "eslint --fix src server server-fastify",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "echo \"No tests configured yet\" && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "ws:server": "tsx server/websocket.ts",
    "queue:worker": "tsx server/queue/worker.ts",
    "temporal:worker": "tsx server/temporal/workers/main.worker.ts",
    "cli": "tsx cli/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.90.5",
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "ldapts": "^8.0.9",
    "node-ssh": "^13.2.1",
    "ora": "^8.1.1",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.9.5",
    "ssh2": "^1.17.0",
    "superjson": "^2.2.2",
    "vite": "^6.4.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@temporalio/testing": "^1.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.23",
    "@types/pino": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pino-pretty": "^13.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix"
    ]
  }
}
